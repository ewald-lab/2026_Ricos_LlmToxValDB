// Main Nextflow Configuration
// Parameters are loaded from params/*.json via the run.sh wrapper

params {
    // ===== Environment Defaults =====
    python_env    = "/nfs/research/ewald/ricos/software/environments/goflowllm_env"
    hf_home       = "/nfs/research/ewald/ricos/huggingface_cache"
    hf_transfer   = "1"
    embeddings_model_id      = "kalm"
}

// Work directory inside nextflow/
workDir = "${projectDir}/work"

// ===== SLURM (Default) =====
process {
    executor = 'slurm'

    beforeScript = """
        module purge
        module load cuda/12.8.0
        module load gcc
        source ${params.python_env}/bin/activate
        export PYTHONPATH=\$PYTHONPATH:${projectDir.parent}
        export PYTHONUNBUFFERED=1
    """

    // --- No GPU needed ---
    withName: 'SPLIT_INPUT' {
        cpus   = 1
        memory = '4 GB'
        time   = '30m'
    }

    // --- GPU processes ---
    withName: 'PROCESS_ONTOLOGY' {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
        clusterOptions = '--gres=gpu:a100:1'
    }

    withName: 'TEXT_TO_ONTO_MAPPING' {
        cpus   = 8
        memory = '32 GB'
        time   = '4h'
        clusterOptions = '--gres=gpu:a100:1'
    }

    // --- No GPU needed ---
    withName: 'AGGREGATE_RESULTS' {
        cpus   = 1
        memory = '4 GB'
        time   = '30m'
    }
}
